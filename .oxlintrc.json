{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"unicorn",
		"oxc",
		"react",
		"react-perf",
		"nextjs",
		"jsx-a11y",
		"import",
		"promise",
		"vitest"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "warn"
	},
	"rules": {
		// Next compiles JSX with the automatic runtime, which is why tsconfig carries
		// `"jsx": "react-jsx"`. Importing React purely to satisfy this rule would add a
		// binding nothing reads.
		"react/react-in-jsx-scope": "off",
		// `import './globals.css'` is how a stylesheet enters the bundle. There is nothing
		// to assign it to. The three chroma-js modules register hex parsing, `rgb()` and
		// `alpha()` on its `Color` class, which `core/contrast/check.ts` needs without the
		// package index (see the comment there).
		"import/no-unassigned-import": [
			"error",
			{
				"allow": [
					"**/*.css",
					"chroma-js/src/io/hex/index.js",
					"chroma-js/src/io/rgb/index.js",
					"chroma-js/src/ops/alpha.js"
				]
			}
		]
	},
	"env": {
		"builtin": true,
		"browser": true,
		"node": true
	},
	"ignorePatterns": ["core/dtcg/*.generated.*", "out/**", ".next/**", "next-env.d.ts"]
}
