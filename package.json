{
  "name": "cambium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn a reference image into an accessible, semantic design token set in W3C DTCG format.",
  "license": "MIT",
  "author": "Kendrick Arnett <kmarnett@gmail.com>",
  "homepage": "https://github.com/kendrick/cambium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kendrick/cambium.git"
  },
  "bugs": {
    "url": "https://github.com/kendrick/cambium/issues"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "color-palette",
    "design-system",
    "design-tokens",
    "dtcg",
    "llm",
    "shadcn-ui",
    "tailwindcss",
    "typescript",
    "wcag"
  ],
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/write-nojekyll.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
