{
  "name": "cambium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn a reference image into an accessible, semantic design token set in W3C DTCG format.",
  "license": "MIT",
  "author": "Kendrick Arnett <kmarnett@gmail.com>",
  "homepage": "https://github.com/kendrick/cambium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kendrick/cambium.git"
  },
  "bugs": {
    "url": "https://github.com/kendrick/cambium/issues"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "color-palette",
    "design-system",
    "design-tokens",
    "dtcg",
    "llm",
    "shadcn-ui",
    "tailwindcss",
    "typescript",
    "wcag"
  ],
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/write-nojekyll.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:bundle": "vitest run --project bundle",
    "dtcg:refresh": "node scripts/refresh-dtcg-schema.mjs",
    "dtcg:build": "node scripts/build-dtcg-validator.mjs",
    "swatches": "node --import ./scripts/lib/register-ts.mjs scripts/swatches.mjs",
    "generate": "node --import ./scripts/lib/register-ts.mjs scripts/generate.mjs",
    "evaluate": "node --import ./scripts/lib/register-ts.mjs scripts/evaluate.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:bundle"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@capsizecss/metrics": "4.3.0",
    "@terrazzo/parser": "2.7.1",
    "@terrazzo/token-tools": "2.7.1",
    "@terrazzo/token-types": "2.7.1",
    "@vibrant/core": "4.0.4",
    "@vibrant/generator-default": "4.0.4",
    "@vibrant/image-browser": "4.0.4",
    "@vibrant/quantizer-mmcq": "4.0.4",
    "chroma-js": "3.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "colorthief": "3.5.0",
    "culori": "4.0.2",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/colors": "3.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.13.0",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
